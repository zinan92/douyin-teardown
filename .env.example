# douyin-teardown 设置。复制成 .env（放仓库根目录或 ~/.douyin-teardown/.env）再填：
#   cp .env.example .env
# .env 不进 git。真正的环境变量优先于这里。空着的行不生效。

# ── 1. 你的抖音 cookies（必填）────────────────────────────────────────────────
# 从浏览器导出（格式见 cookies.json.example），放在仓库外面，chmod 600。
# 空着 = ~/.douyin-teardown/cookies.json
TEARDOWN_COOKIES=

# 报告、下载、作者中位数缓存放哪。空着 = ~/.douyin-teardown/data
TEARDOWN_DATA_DIR=

# ── 2. 谁来读文字稿（四选一）──────────────────────────────────────────────────
# 命令行：codex（先 codex login）| claude（先在终端登录 Claude Code）
# API：  deepseek | anthropic
TEARDOWN_AI=codex

TEARDOWN_CODEX_MODEL=
TEARDOWN_CLAUDE_MODEL=
# 定时任务里跑时写绝对路径（which codex / which claude 的输出）
TEARDOWN_CODEX_BIN=
TEARDOWN_CLAUDE_BIN=

# deepseek → https://platform.deepseek.com/api_keys
TEARDOWN_DEEPSEEK_KEY=
# 任何 OpenAI 兼容的 /chat/completions 都行
TEARDOWN_DEEPSEEK_ENDPOINT=
TEARDOWN_DEEPSEEK_MODEL=

# anthropic → https://console.anthropic.com/settings/keys ；模型空着 = claude-sonnet-5-5
ANTHROPIC_API_KEY=
TEARDOWN_ANTHROPIC_MODEL=

# ── 3. 转文字 ────────────────────────────────────────────────────────────────
# Apple 芯片的 Mac 装了 [mlx] 自动用 GPU；其他电脑用 faster-whisper（CPU）。
# 强制指定：mlx | faster
CONTENT_EXTRACTOR_WHISPER_BACKEND=
